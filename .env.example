# --- Supabase --------------------------------------------------------------
# Project URL and anon key from https://app.supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service-role key — server-only. NEVER expose to the browser.
# Used by API routes and the ingest script for admin-level inserts/RPC calls.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Gemini ---------------------------------------------------------------
# Get one at https://aistudio.google.com (free tier: 15 RPM, 1M tokens/day)
GEMINI_API_KEY=YOUR-GEMINI-KEY

# --- Groq (Fallback) ------------------------------------------------------
# Get free key at https://console.groq.com (free tier: 30 RPM, 20K tokens/min)
# Used automatically when Gemini hits rate limits
GROQ_API_KEY=YOUR-GROQ-KEY

# --- Hugging Face (Embeddings Fallback) -------------------------------------
# Get free key at https://huggingface.co/settings/tokens
# Used for embeddings when Gemini quota is exceeded
HF_API_KEY=YOUR-HF-KEY

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Bots (Phase 3) --------------------------------------------------------
# Telegram token from @BotFather
TELEGRAM_BOT_TOKEN=YOUR-TELEGRAM-BOT-TOKEN

# Twilio WhatsApp Sandbox (optional for webhook signature verification later)
TWILIO_ACCOUNT_SID=YOUR-TWILIO-ACCOUNT-SID
TWILIO_AUTH_TOKEN=YOUR-TWILIO-AUTH-TOKEN

# --- Capacitor (Phase 3 Mobile APK) ----------------------------------------
# Android emulator can use http://10.0.2.2:3000 when `npm run dev` is running.
CAPACITOR_SERVER_URL=http://10.0.2.2:3000

# --- Local dev switches -----------------------------------------------------
# Enable self-service role switching (student <-> teacher) in /settings.
ENABLE_ROLE_SWITCH=false

# --- Default Admin Bootstrap -----------------------------------------------
# Run `npm run seed:admin` to ensure this admin user always exists.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_NAME=Askuala Admin
